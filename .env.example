# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# --- Square API ---
# From the Square Developer Dashboard (developer.squareup.com/apps):
#   Sandbox: use your Sandbox Access Token for testing with fake data.
#   Production: use your Production Access Token once you're ready to go live.
SQUARE_ACCESS_TOKEN=

# "sandbox" or "production" — controls which Square API host we call.
SQUARE_ENVIRONMENT=sandbox

# One or more location IDs to show orders for, comma-separated.
# Find these at developer.squareup.com/apps -> your app -> Locations,
# or via GET https://connect.squareup.com/v2/locations with your token.
SQUARE_LOCATION_IDS=

# --- Server ---
# Port the KDS server listens on.
PORT=3000

# How often (in ms) to poll Square for order changes.
# Only used until you upgrade to real-time webhooks (see README).
POLL_INTERVAL_MS=5000

# If set to "true" and no SQUARE_ACCESS_TOKEN is provided, the server runs
# in demo mode and generates fake orders so you can preview the KDS UI
# without a Square account yet.
DEMO_MODE=true
